// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in your
// Supabase project values. Project Settings -> API.
//
// IMPORTANT: xcconfig treats `//` as the start of a comment, so the `https://`
// in the URL MUST be written as `https:/$()/` — the `$()` expands to nothing at
// build time, yielding `https://...` while preventing xcconfig from eating the
// rest of the line. Keep the `$()` exactly as shown.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-public-anon-key
